# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore bundler config.
.bundle

# Ignore the default Rails log files.
log/*
!log/.keep

# Ignore temp files.
tmp/*
!tmp/.keep

# Ignore generated files.
public/assets
public/packs
public/packs-test

# Ignore SQLite3 database files.
db/*.sqlite3
db/*.sqlite3-journal

# Ignore MongoDB's data folder if using local MongoDB.
# (Usually not needed if using remote MongoDB or cloud services like Atlas)
# db/mongoid.yml (config)
# db/mongoid/ # Uncomment if you're using a local MongoDB for development

# Ignore Mongoid's .mongoid.yml
config/mongoid.yml

# Ignore Byebug command history.
.byebug_history

# Ignore RubyMine project files.
.idea/

# Ignore the .env file that stores environment variables.
.env
.env.local
.env.development
.env.test
.env.production

# Ignore credentials files generated by Rails.
config/credentials.yml.enc
config/master.key

# Ignore Sprockets generated files.
public/assets/
public/system/
public/uploads/

# Ignore Yarn files.
yarn-error.log
node_modules/

# Ignore the cache folder.
.cache/

# Ignore the database storage folder.
storage/

# Ignore files generated by Rails tests.
*.log
*.pid
*.seed

# Ignore coverage folder from test suite (e.g., SimpleCov).
coverage/

# Ignore generated files from Rails generators.
*.gem
*.rbc
*.sassc

# Ignore macOS specific files.
.DS_Store

# Ignore the Vim swap files.
*.swp

# Ignore the gemspec for non-gem-based Rails applications.
*.gemspec

# Ignore Rails master key if using Rails 5.2+ encrypted credentials.
config/master.key

# Ignore the package lock file if using Yarn instead of npm.
package-lock.json
